PORT=8080
RYVO_GATEWAY_BASE_URL=https://gateway.ryvo.network

# Required for exact-payment Solana routes and the internal facilitator endpoints.
RYVO_FACILITATOR_WALLET_BASE58=
RYVO_INTERNAL_SETTLEMENT_SECRET=replace-with-long-random-secret

# Payment rail
RYVO_X402_PAY_TO_WALLET=
RYVO_X402_MAINNET_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
RYVO_X402_DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
RYVO_RATE_LIMIT_RPC_RPS=50
RYVO_RATE_LIMIT_DAS_RPS=10
RYVO_RATE_LIMIT_TOKENS_PER_MINUTE=30
RYVO_RATE_LIMIT_CHALLENGE_PER_MINUTE=120

# Provider upstreams
ALCHEMY_MAINNET_RPC_URL=
ALCHEMY_DEVNET_RPC_URL=
HELIUS_MAINNET_RPC_URL=
HELIUS_DEVNET_RPC_URL=
# Bare Helius API key used as X-Api-Key for the Helius Wallet API (mainnet-only).
HELIUS_API_KEY=
HELIUS_WALLET_API_BASE_URL=https://api.helius.xyz
TOKENS_API_BASE_URL=https://api.tokens.xyz
TOKENS_API_KEY=

# Upstash Redis (required for hosted replay protection + rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ryvo Protocol channel payments (devnet, official USDC only)
RYVO_PROTOCOL_PROGRAM_ID=
RYVO_PROTOCOL_DEVNET_USDC_TOKEN_ID=
# Optional fallback for resolving the official devnet USDC token ID.
RYVO_PROTOCOL_DEVNET_DEPLOYMENT_CONFIG=
RYVO_GATEWAY_MERCHANT_OWNER=
RYVO_GATEWAY_MERCHANT_PARTICIPANT_ID=
RYVO_PROTOCOL_MESSAGE_VERSION=1
RYVO_PROTOCOL_DEVNET_CHAIN_ID=1
RYVO_CHANNEL_SNAPSHOT_TTL_MS=2000
RYVO_CHANNEL_SETTLEMENT_MIN_DELTA=0.250000
RYVO_CHANNEL_SETTLEMENT_MAX_AGE_SECONDS=300
RYVO_CHANNEL_SETTLEMENT_MIN_HEADROOM_BPS=1000
